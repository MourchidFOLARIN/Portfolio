# Variables du formulaire de contact (api/contact.js).
# À définir dans Vercel > Settings > Environment Variables, jamais dans le dépôt.

# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=re_your_key

# Destinataire. Valeur par défaut si la variable est absente :
# mourchidolawale@gmail.com
CONTACT_TO=mourchidolawale@gmail.com

# Expéditeur vérifié dans Resend.
# onboarding@resend.dev ne livre qu'à l'adresse du compte Resend.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
